# Bilanço — ortam değişkenleri (kopyala: cp .env.example .env)
# Hiçbir gizli anahtar kaynak koduna veya git deposuna yazılmaz.

# PostgreSQL (docker-compose varsayılanları)
DATABASE_URL=postgresql+psycopg2://bilanco:bilanco@db:5432/bilanco
# Geliştirme / test için SQLite de kullanılabilir:
# DATABASE_URL=sqlite:///./bilanco.db

# Redis (önbellek / görev kuyruğu)
REDIS_URL=redis://redis:6379/0

# TCMB EVDS API anahtarı — SADECE ortam değişkeni; loglanmaz, UI'da gösterilmez.
EVDS_API_KEY=

# İndirme davranışı
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=3
HTTP_USER_AGENT=BilancoBot/0.1 (+https://bilanco.vercel.app; veri toplama; iletisim: admin@localhost)
RAW_STORE_DIR=./data/raw
MIN_SECONDS_BETWEEN_REQUESTS=2
# robots.txt: strict (varsayılan, yasaklı yol indirilmez) | lenient (uyarı + devam; yalnızca yapılandırılmış resmî istatistik dosyaları)
ROBOTS_POLICY=strict

# Zamanlayıcı
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Europe/Istanbul

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
